#!/bin/sh
#SBATCH --job-name="step46_childplay_full"
#SBATCH --partition=gpu_risk
#SBATCH --gres=gpu:3g.40gb:1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=32G
#SBATCH --time=06-12:00:00
#SBATCH -o slurm.%N.%j.out
#SBATCH -e slurm.%N.%j.err

cd /parallel_scratch/sl02092/standard_project

export HF_HUB_OFFLINE=1

# Full production run. TEST_MODE/PROMPT_TEST left unset (default False) ->
# script's own defaults apply: labels_childplay_hybrid_targeted.jsonl,
# progress_childplay_hybrid_targeted.json, pipeline_childplay_hybrid_targeted.log
export TEACHER_MANIFEST_PATH="/parallel_scratch/sl02092/standard_project/frame_manifest_childplay.csv"

# Calibration-derived estimate: ~116.7 hours (4.9 days) -- longer than step40
# since the object route has no solo-frame skip shortcut (all 164,878 object
# frames get genuine hybrid inference here, vs. step40's ~145k). --time set
# to 6d12h, real buffer under the 7-day cap. Same gpu_risk/checkpoint
# reasoning as step40's .sub.
apptainer exec --nv oras://container-registry.surrey.ac.uk/shared-containers/pytorch:latest \
    /parallel_scratch/sl02092/standard_project/venv/bin/python3 -u step46_hybrid_teacher_pipeline_childplay.py
