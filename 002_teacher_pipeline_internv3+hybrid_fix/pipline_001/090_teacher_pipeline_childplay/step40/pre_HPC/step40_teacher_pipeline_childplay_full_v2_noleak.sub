#!/bin/sh
#SBATCH --job-name="step40_childplay_full_noleak"
#SBATCH --partition=gpu_risk
#SBATCH --gres=gpu:3g.40gb:1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=32G
#SBATCH --time=05-12:00:00
#SBATCH -o slurm.%N.%j.out
#SBATCH -e slurm.%N.%j.err

cd /parallel_scratch/sl02092/standard_project

export HF_HUB_OFFLINE=1


# ── RERUN ENVIRONMENT (patch_teacher_noleak.py) ──────────────────────
# TEACHER_RERUN_TAG decides the output filenames. It MUST be identical on
# every resubmission of this job: change it and the resume cannot find its
# own partial output, so the run silently restarts from zero.
export TEACHER_RERUN_TAG="noleak"

# Probe before committing the full run. Both write to their own
# *_prompt_test_* / *_test_* files and never touch production output:
#   export TEACHER_PROMPT_TEST=1   # step40: prints raw responses, parse rate, mean distance; writes nothing
#   export TEACHER_TEST_MODE=1     # ~50 frames end to end, real output files

# Full production run. TEST_MODE/PROMPT_TEST left unset (default False) ->
# script's own defaults apply: labels_childplay_full.jsonl,
# progress_childplay_full.json, pipeline_childplay_full.log
export TEACHER_MANIFEST_PATH="/parallel_scratch/sl02092/standard_project/frame_manifest_childplay.csv"

# Calibration-derived estimate: ~95.4 hours (4.0 days) real inference time.
# --time set to 5d12h -- real buffer over the estimate, comfortably under
# the 7-day partition cap. On gpu_risk: preemption auto-requeues (Eureka2
# docs, confirmed), existing SAVE_EVERY_N checkpointing means at most ~10
# records lost per preemption, not a restart from zero. If this job still
# hits its own --time limit before finishing, resubmitting is safe --
# recover_progress_from_jsonl() picks up exactly where labels_childplay_full.jsonl
# left off.
apptainer exec --nv oras://container-registry.surrey.ac.uk/shared-containers/pytorch:latest \
    /parallel_scratch/sl02092/standard_project/venv/bin/python3 -u step40_teacher_pipeline_childplay_noleak.py
# NOTE: outputs are now labels_*_noleak.jsonl / progress_*_noleak.json /
# pipeline_*_noleak.log -- any filename in the comments above is the
# FROZEN run's and is no longer what this job writes.
