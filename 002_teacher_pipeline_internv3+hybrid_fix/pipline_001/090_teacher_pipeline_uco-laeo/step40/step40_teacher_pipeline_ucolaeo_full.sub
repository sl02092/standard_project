#!/bin/sh
#SBATCH --job-name="step40_ucolaeo_full"
#SBATCH --partition=gpu_risk
#SBATCH --gres=gpu:3g.40gb:1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=32G
#SBATCH --time=00-16:00:00
#SBATCH -o slurm.%N.%j.out
#SBATCH -e slurm.%N.%j.err

cd /parallel_scratch/sl02092/standard_project

export HF_HUB_OFFLINE=1
# TEACHER_TEST_MODE/PROMPT_TEST left unset -> full production run.

# Calibration-derived estimate: ~9.6 hours (21,584 rows, ~1.6s/frame
# converged rate). --time set to 16h for real buffer.
apptainer exec --nv oras://container-registry.surrey.ac.uk/shared-containers/pytorch:latest \
    /parallel_scratch/sl02092/standard_project/venv/bin/python3 -u step40_teacher_pipeline_ucolaeo.py
