#!/bin/sh
#SBATCH --job-name="step40_vat_testshows_full"
#SBATCH --partition=gpu_risk
#SBATCH --gres=gpu:3g.40gb:1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=32G
#SBATCH --time=01-00:00:00
#SBATCH -o slurm.%N.%j.out
#SBATCH -e slurm.%N.%j.err

cd /parallel_scratch/sl02092/standard_project

export HF_HUB_OFFLINE=1
# TEACHER_TEST_MODE/PROMPT_TEST left unset -> full production run.

# Rough estimate from VAT's own historical rate (23,096 rows / 5.79h =
# 0.90s/row) applied to this population's 19,563 use_teacher=True rows:
# ~5 hours. --time set to 16h for real buffer -- confirm against the
# calibration job's actual sacct timing before trusting this further.
apptainer exec --nv oras://container-registry.surrey.ac.uk/shared-containers/pytorch:latest \
    /parallel_scratch/sl02092/standard_project/venv/bin/python3 -u step40_teacher_pipeline_vat_testshows.py
