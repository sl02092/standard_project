#!/bin/sh
#SBATCH --job-name="step46_vat_testshows_full"
#SBATCH --partition=gpu_risk
#SBATCH --gres=gpu:3g.40gb:1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=32G
#SBATCH --time=01-00:00:00
#SBATCH -o slurm.%N.%j.out
#SBATCH -e slurm.%N.%j.err

cd /parallel_scratch/sl02092/standard_project

export HF_HUB_OFFLINE=1
# TEACHER_TEST_MODE/PROMPT_TEST left unset -> full production run.

# No VAT-specific hybrid rate exists yet -- the original 54h .sub was sized
# for a much larger population than this one (19,563 use_teacher rows).
# --time set to 24h as a rough, generously-buffered placeholder; replace
# with a real value once the calibration job's sacct timing is in.
apptainer exec --nv oras://container-registry.surrey.ac.uk/shared-containers/pytorch:latest \
    /parallel_scratch/sl02092/standard_project/venv/bin/python3 -u step46_hybrid_teacher_pipeline_vat_testshows.py
